diff --git a/tcm-frontend/src/constants/bugWorkflow.ts b/tcm-frontend/src/constants/bugWorkflow.ts
new file mode 100644
index 0000000..2fda121
--- /dev/null
+++ b/tcm-frontend/src/constants/bugWorkflow.ts
@@ -0,0 +1,41 @@
+import type { BugStatus, Role } from '../types/entities';
+
+export interface BugStatusTransition {
+  from: BugStatus;
+  to: BugStatus;
+  role: Role;
+  label: string;
+}
+
+/**
+ * State machine untuk status bug.
+ *
+ * ASUMSI (perlu dikonfirmasi ke stakeholder, sama seperti asumsi lain di
+ * rancangan-tcm-system.md): urutan alur dirancang sebagai
+ *   Open -> On Progress Dev -> Ready to Test -> On Progress QA -> Close
+ *                                                              -> Reopen -> On Progress Dev (ulang)
+ *   Open -> Hold / Take Out (untuk bug yang ditunda atau invalid/duplikat)
+ *   Hold -> Open (lanjutkan lagi)
+ *
+ * Backend WAJIB memvalidasi transisi ini juga (lihat pola
+ * `bug_status_transitions` di rancangan-tcm-system.md) — daftar di sini
+ * hanya mengontrol tombol mana yang tampil di UI (UX), bukan enforcement
+ * sesungguhnya.
+ */
+export const BUG_STATUS_TRANSITIONS: BugStatusTransition[] = [
+  { from: 'Open', to: 'On Progress Dev', role: 'DEV', label: 'Mulai Dikerjakan (On Progress Dev)' },
+  { from: 'Open', to: 'Hold', role: 'QA', label: 'Hold' },
+  { from: 'Open', to: 'Take Out', role: 'QA', label: 'Take Out' },
+  { from: 'On Progress Dev', to: 'Ready to Test', role: 'DEV', label: 'Ready to Test' },
+  { from: 'On Progress Dev', to: 'Hold', role: 'DEV', label: 'Hold' },
+  { from: 'Ready to Test', to: 'On Progress QA', role: 'QA', label: 'Mulai Retest (On Progress QA)' },
+  { from: 'On Progress QA', to: 'Close', role: 'QA', label: 'Tandai Close (lolos retest)' },
+  { from: 'On Progress QA', to: 'Reopen', role: 'QA', label: 'Reopen (gagal retest)' },
+  { from: 'Reopen', to: 'On Progress Dev', role: 'DEV', label: 'Mulai Dikerjakan Ulang' },
+  { from: 'Hold', to: 'Open', role: 'QA', label: 'Lanjutkan (Unhold)' },
+];
+
+export function availableTransitions(status: BugStatus, role?: Role): BugStatusTransition[] {
+  if (!role) return [];
+  return BUG_STATUS_TRANSITIONS.filter((t) => t.from === status && t.role === role);
+}
